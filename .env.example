# Optional providers; local upload, playback and tests need no third-party packages.
NVIDIA_API_KEY=
NVIDIA_MAX_SPEAKERS=8
NVIDIA_TIMEOUT_SECONDS=1800
# Enable hotwords only after a successful probe; the initial probe timed out.
ASR_HOTWORDS=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Use the confirmed user's identity, either through an existing CLI profile or a user token.
FEISHU_AUTH_MODE=user_token
FEISHU_CLI_PROFILE=
FEISHU_USER_ACCESS_TOKEN=
FEISHU_EXPECTED_OPEN_ID=
FEISHU_PERSONAL_CONFIRMED=0
FEISHU_FOLDER_TOKEN=
# Required before writing a usable protected playback link into Feishu.
PUBLIC_ORIGIN=
# Enable only after provider probes pass. Otherwise use stage buttons.
AUTO_PIPELINE=0
# Local integration only: documents clearly state that playback is not deployed.
FEISHU_LOCAL_PREVIEW=0
ASR_CHUNK_SECONDS=120
# unknown is conservative; zero_based is the observed NIM A/B/A profile, not accuracy acceptance.
NVIDIA_SPEAKER_ZERO_POLICY=unknown

# Provider defaults; the app can override these in private server settings.
ASR_PROVIDER=nvidia_parakeet
ASR_LANGUAGE=zh-CN
ASR_BASE_URL=
ASR_MODEL=whisper-1
ASR_API_KEY=
ASR_RESPONSE_FORMAT=verbose_json
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOCS_ORIGIN=https://www.feishu.cn
DOCUMENT_TIMEZONE=Asia/Shanghai
